DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIME_ZONE=America/Sao_Paulo

POSTGRES_DB=crm_financeiro
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@crm-financeiro.local

AI_PROVIDER=local
AI_EXTERNAL_API_URL=
AI_EXTERNAL_API_KEY=
AI_EXTERNAL_MODEL=gemini-2.5-flash
AI_EXTERNAL_NON_TRAINING_APPROVED=false
AI_EXTERNAL_RETENTION_ZERO_APPROVED=false
FILE_ENCRYPTION_KEY=dev-only-file-encryption-key-change-in-production
COST_ANOMALY_THRESHOLD_PCT=12.0
FRONTEND_APP_URL=http://127.0.0.1:5173

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
